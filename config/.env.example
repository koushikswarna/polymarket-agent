# Polymarket API Credentials
# Get CLOB API credentials from: https://docs.polymarket.com
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# Ethereum Wallet (for signing orders)
PRIVATE_KEY=your_ethereum_private_key_here

# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Trading Configuration
DRY_RUN=true
STARTING_CAPITAL=10.0
MAX_POSITION_SIZE=3.0
MAX_TOTAL_EXPOSURE=8.0
DAILY_LOSS_LIMIT=3.0

# LLM Budgets (in USD)
ANTHROPIC_BUDGET=4.50
OPENAI_BUDGET=5.00

# Risk Parameters
MIN_EDGE_THRESHOLD=0.05
MIN_LIQUIDITY=500.0
MAX_OPEN_POSITIONS=8
CONSECUTIVE_LOSS_COOLDOWN=5

# Market Filters
MIN_HOURS_TO_RESOLUTION=6
MAX_DAYS_TO_RESOLUTION=60
MIN_PRICE=0.03
MAX_PRICE=0.97

# Polling Intervals (seconds)
MARKET_SCAN_INTERVAL=300
POSITION_CHECK_INTERVAL=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=trading.log
